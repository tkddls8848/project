NARA_SEARCH_URL=http://127.0.0.1:8000
NARA_COMBINER_URL=http://127.0.0.1:8003
NARA_REQUEST_TIMEOUT=30
NARA_COMPOSE_TIMEOUT=240

# OpenAI is used only by the Hermes judgement profile. Copy this file to .env
# and insert your key locally; .env is excluded from Git.
OPENAI_API_KEY=
NARA_HERMES_PROFILE=nara-openai
NARA_HERMES_MODEL=gpt-5.4-mini
NARA_HERMES_TIMEOUT=75
NARA_HERMES_PROBE=1

# Cheaper alternative for test runs: the `nara-cf` Hermes profile routes the
# judgement model to Cloudflare Workers AI over its OpenAI-compatible endpoint.
# Set the account id in ~/.hermes/profiles/nara-cf/config.yaml, put the Workers
# AI token here, and swap the two NARA_HERMES_* values below.  Only pick models
# that advertise function calling — the probe verifies MCP tool invocation, so a
# model that cannot call tools makes the run meaningless.  Small models tend to
# need a longer timeout than the OpenAI profile.
# CLOUDFLARE_API_TOKEN=
# NARA_HERMES_PROFILE=nara-cf
# NARA_HERMES_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# NARA_HERMES_TIMEOUT=120

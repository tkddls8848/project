NARA_SEARCH_URL=http://127.0.0.1:8000
NARA_COMBINER_URL=http://127.0.0.1:8003
NARA_REQUEST_TIMEOUT=30
NARA_COMPOSE_TIMEOUT=240

# Cloudflare token needs Workers AI: Read permission.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NARA_CLOUDFLARE_PROXY_PORT=8643
NARA_CLOUDFLARE_PROXY_KEY=change-me-local-proxy
NARA_HERMES_PROFILE=nara-cf
NARA_HERMES_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
HERMES_API_URL=http://127.0.0.1:8642
API_SERVER_KEY=change-me-local-dev
NARA_HERMES_RUN_TIMEOUT=300
# 검색 1회 + 상세 3회. 호출마다 이전 도구 결과가 다시 전송된다.
NARA_HERMES_MAX_TOOL_CALLS=4

# Local post-run verification; no additional LLM call is made.
NARA_CRITIC_MODE=deterministic
NARA_CRITIC_TIMEOUT=60

# Empty index time reports freshness as unverified.
NARA_DOC_FRESHNESS_MODE=deterministic
# NARA_STORAGE_DIR=C:\project\nara_storage
NARA_INDEX_BUILT_AT=
